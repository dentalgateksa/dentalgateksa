rules_version = '2';

// DENTALGATE — Cloud Storage security rules.
//
// Scan files live at cases/{caseId}/{n}-{name}.
//   Doctor (no login)  -> may upload new files for a case that has not been
//                         submitted yet. Cannot read, list, overwrite or delete.
//   Technician (staff) -> may download files.
//   Admin              -> may also delete files.
// Staff/admin status is read from Firestore (staff/{uid}), same as firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {

    function staffPath() {
      return /databases/(default)/documents/staff/$(request.auth.uid);
    }

    function isStaff() {
      return request.auth != null && firestore.exists(staffPath());
    }

    function isAdmin() {
      return isStaff() && firestore.get(staffPath()).data.isAdmin == true;
    }

    match /cases/{caseId}/{fileName} {
      allow read: if isStaff();
      allow delete: if isAdmin();
      allow create: if resource == null
        && caseId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && fileName.matches('^[0-9]{1,2}-[A-Za-z0-9_.-]{1,100}$')
        && fileName.lower().matches('.*[.](stl|ply|obj|zip|dcm|pdf|jpg|jpeg|png)$')
        && request.resource.size <= 50 * 1024 * 1024
        && !firestore.exists(/databases/(default)/documents/cases/$(caseId));
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
